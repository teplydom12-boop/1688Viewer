{
  "name": "1688-viewer",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension for collecting 1688 search results into a single JSON file",
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.cjs",
