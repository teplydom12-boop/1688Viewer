{
  "manifest_version": 3,
  "name": "1688 Viewer — сбор поставщиков",
  "version": "0.1.0",
  "description": "Собирает товары из открытой выдачи 1688 и сохраняет общий JSON для сравнения поставщиков.",
  "permissions": ["activeTab", "scripting", "storage", "downloads", "alarms"],
  "host_permissions": ["https://*.1688.com/*", "https://1688.com/*"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" },
    "default_popup": "popup.html",
    "default_title": "1688 Viewer"
  },
  "content_scripts": [{
    "matches": ["https://*.1688.com/*", "https://1688.com/*"],
    "js": ["shared.js", "content.js"],
    "run_at": "document_idle"
  }]
}
